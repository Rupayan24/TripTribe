<% layout("/layouts/boilerplate") %>

<main class="site-container form-page">
  <p class="eyebrow mb-0">Your next trip can wait right here</p>
  <h1>Good to see you.</h1>
  <form action="/login" method="POST" class="needs-validation form-card" novalidate>
    <div class="mb-3">
      <label for="username" class="form-label">Username</label>
      <input name="username" id="username" type="text" class="form-control" autocomplete="username" required>
      <div class="invalid-feedback">Enter your username.</div>
    </div>

    <div class="mb-4">
      <label for="password" class="form-label">Password</label>
      <input name="password" id="password" type="password" class="form-control" autocomplete="current-password" required>
      <div class="invalid-feedback">Enter your password.</div>
    </div>
    <button class="btn btn-dark px-4 py-2" type="submit">Log in</button>
    <p class="detail-location mt-3 mb-0">New around here? <a href="/signup">Make an account</a></p>
  </form>
</main>
