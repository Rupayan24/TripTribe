<% layout("/layouts/boilerplate") %>

<main class="site-container">
  <section class="explore-intro">
    <div>
      <p class="eyebrow mb-0">For the days you’ll remember</p>
      <h1 class="display-heading">Somewhere <em>good</em><br>to get away.</h1>
    </div>
    <p class="explore-copy">Little cabins, long weekends, and places that make you want to stay an extra night. Find a spot that feels like yours.</p>
  </section>

  <section aria-label="Available stays">
    <div class="listing-toolbar">
      <p class="listing-count">
        <% if(searchQuery) { %>
          <%= allListings.length %> <%= allListings.length === 1 ? "stay" : "stays" %> for “<%= searchQuery %>”
        <% } else { %>
          Thoughtful places, picked for your next trip
        <% } %>
      </p>
      <div class="tax-toggle">
        <div class="form-check form-switch">
          <input class="form-check-input" type="checkbox" id="tax-switch" role="switch">
          <label class="form-check-label" for="tax-switch">Show total with taxes</label>
        </div>
      </div>
    </div>

    <div class="row row-cols-1 row-cols-sm-2 row-cols-lg-3 row-cols-xl-4 listing-grid">
      <% if(allListings.length) { %>
        <% for(let listing of allListings) { %>
          <a href="/listings/<%= listing._id %>" class="listing-link col">
            <article class="card listing-card">
              <div class="listing-photo-wrap">
                <img
                  src="<%= listing.image?.url || 'https://images.unsplash.com/photo-1510798831971-661eb04b3739?auto=format&fit=crop&w=1000&q=85' %>"
                  class="listing-photo"
                  alt="<%= listing.title %>"
                  loading="lazy"
                >
                <span class="photo-shade" aria-hidden="true"></span>
              </div>
              <div class="card-body">
                <div class="listing-place">
                  <span><i class="fa-solid fa-location-dot" aria-hidden="true"></i><%= listing.location %>, <%= listing.country %></span>
                </div>
                <h2 class="listing-title"><%= listing.title %></h2>
                <p class="listing-price mb-0">
                  <strong>₹<%= listing.price.toLocaleString("en-IN") %></strong> / night
                  <span class="tax-info"> · ₹<%= Math.round(listing.price * 1.18).toLocaleString("en-IN") %> total with taxes</span>
                </p>
              </div>
            </article>
          </a>
        <% } %>
      <% } else { %>
        <div class="empty-state col-12">
          <i class="fa-solid fa-map-location-dot" aria-hidden="true"></i>
          <h2 class="section-heading mb-2">No stays found just yet</h2>
          <p class="mb-3">Try another place or search for something a little broader.</p>
          <a href="/listings" class="btn btn-outline-dark btn-sm">See every stay</a>
        </div>
      <% } %>
    </div>
  </section>
</main>

<script>
  const taxSwitch = document.getElementById("tax-switch");
  taxSwitch.addEventListener("change", () => {
    document.querySelectorAll(".tax-info").forEach((info) => {
      info.style.display = taxSwitch.checked ? "inline" : "none";
    });
  });
</script>
