<% layout("/layouts/boilerplate") %>

<main class="site-container form-page">
  <p class="eyebrow mb-0">A good stay starts here</p>
  <h1>Share a place you love.</h1>
  <form method="POST" action="/listings" novalidate class="needs-validation form-card" enctype="multipart/form-data">
    <div class="mb-3">
      <label for="title" class="form-label">Give your place a name</label>
      <input name="listing[title]" id="title" placeholder="A quiet cabin near the lake" type="text" class="form-control" required>
      <div class="valid-feedback">The title looks good.</div>
      <div class="invalid-feedback">Add a name for your place.</div>
    </div>

    <div class="mb-3">
      <label for="description" class="form-label">What makes it special?</label>
      <textarea name="listing[description]" id="description" class="form-control" placeholder="Tell guests what a day here might feel like." required></textarea>
      <div class="invalid-feedback">Add a short description.</div>
    </div>

    <div class="mb-3">
      <label for="image" class="form-label">A photo guests will remember</label>
      <input name="listing[image]" id="image" type="file" class="form-control" accept="image/*" required>
      <div class="invalid-feedback">Choose a photo of your place.</div>
    </div>

    <div class="row">
      <div class="mb-3 col-md-4">
        <label for="price" class="form-label">Price per night (₹)</label>
        <input name="listing[price]" id="price" placeholder="1200" type="number" min="0" class="form-control" required>
        <div class="invalid-feedback">Enter a valid nightly price.</div>
      </div>
      <div class="mb-3 col-md-8">
        <label for="country" class="form-label">Country</label>
        <input name="listing[country]" id="country" placeholder="India" type="text" class="form-control" required>
        <div class="invalid-feedback">Add the country.</div>
      </div>
    </div>

    <div class="mb-4">
      <label for="location" class="form-label">Where can guests find it?</label>
      <input name="listing[location]" id="location" placeholder="Jaipur, Rajasthan" type="text" class="form-control" required>
      <div class="invalid-feedback">Add a town, city, or region.</div>
    </div>

    <button class="btn btn-dark add-btn px-4 py-2" type="submit">Publish your stay</button>
  </form>
</main>
